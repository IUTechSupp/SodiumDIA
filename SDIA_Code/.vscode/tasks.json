{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build STM32",
            "type": "shell",
            "command": "cd ${input:project_id} && source scripts/build.sh",
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "problemMatcher": {
                "base": "$gcc",
                "fileLocation": "absolute"
            }
        },
        {
            "label": "Compile Font",
            "type": "shell",
            "command": "cd ${input:project_id} && source scripts/load_font.sh",
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "problemMatcher": {
                "base": "$gcc",
                "fileLocation": "absolute"
            }
        }
    ],
    "inputs": [
        {
            "id": "project_id",
            "type": "pickString",
            "description": "Проект для сборки",
            "options": [
                "SodiumDIA_STM32",
            ],
            "default": "SodiumDIA_STM32"
        },
    ]
}
{
    // Настройки для расширения Cortex-Debug
    "cortex-debug.variableUseNaturalFormat": false,
    "openocdScriptPath": "C:/Users/user/Documents/OpenOCD-20260302-0.12.0/share/openocd/scripts",
    "cortex-debug.openocdPath": "C:/Users/user/Documents/OpenOCD-20260302-0.12.0/bin/openocd.exe",
    "cortex-debug.armToolchainPath": "C:/Program Files (x86)/Arm/GNU Toolchain mingw-w64-i686-arm-none-eabi/bin",
    "cortex-debug.enableTelemetry": false,
    // Настройки терминала для использования MSYS2
    "terminal.integrated.env.windows": {
        "CHERE_INVOKING": "1",
        "MSYSTEM": "MSYS",
        "MSYS2_PATH_TYPE": "inherit",
    },
    "terminal.integrated.profiles.windows": {
        "Command Prompt": {
            "path": [
                "C:/msys64/usr/bin/bash.exe", //путь к msys
            ],
            "args": [
                "--login"
            ],
            "icon": "terminal-cmd"
        }
    },
    "terminal.integrated.defaultProfile.windows": "Command Prompt",
    // Python settings
    "python.defaultInterpreterPath": "${workspaceFolder}/.venv/Scripts/python.exe",
    "python.terminal.activateEnvironment": true,
    "python.venvPath": "${workspaceFolder}",
    "python.venvFolders": [
        ".venv"
    ],
    "editor.formatOnSave": true,
    "python.formatting.provider": "black",
    "python.formatting.blackArgs": [
        "--line-length",
        "88"
    ],
    "python.linting.enabled": true,
    "python.linting.pylintEnabled": true,
    "python.linting.flake8Enabled": false,
    "python.analysis.typeCheckingMode": "basic",
    "python.analysis.autoImportCompletions": true,
    "files.exclude": {
        "**/__pycache__": true,
        "**/.pytest_cache": true,
        "**/.venv": false
    },
    "[python]": {
        "editor.formatOnType": true,
        "editor.codeActionsOnSave": {
            "source.organizeImports": "explicit"
        },
        "editor.defaultFormatter": "ms-python.black-formatter"
    },
    "C_Cpp.default.compilerPath": "\"C:/Program Files (x86)/Arm/GNU Toolchain mingw-w64-i686-arm-none-eabi/bin/arm-none-eabi-gcc-15.2.1.exe\"",
}